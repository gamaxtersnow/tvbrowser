              "fill": "#67E8F9",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "联网验收：先裸板测试 Wi‑Fi RSSI，再装外壳；铁盒里信号差就把天线露出。",
              "lineHeight": 1.15,
              "fontFamily": "Inter",
              "fontSize": 25,
              "fontWeight": "normal"
            }
